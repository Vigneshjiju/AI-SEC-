{
  "name": "@niraven/mcp-gateway",
  "version": "0.2.0",
  "description": "Security-first gateway proxy for MCP servers — rate limiting, approval gates, security scanning, audit logging, and run reports",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-gateway": "dist/cli.js",
    "mcp-sentinel": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').copyFileSync('src/dashboard/index.html','dist/dashboard/index.html')\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/gateway.test.ts tests/sentinel.test.ts tests/control-plane.test.ts",
    "test:integration": "vitest run tests/scenarios.test.ts",
    "console": "tsx src/cli.ts console",
    "demo": "tsx test/demo.ts",
    "demo:all": "tsx test/demo.ts --all",
    "demo:live": "tsx test/demo.ts --dashboard",
    "evaluate": "tsx test/evaluation.ts",
    "sentinel": "tsx src/cli.ts start -c mcp-sentinel.json -d",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "security",
    "gateway",
    "agent",
    "firewall",
    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niraven/mcp-gateway.git"
  },
  "author": "Niraven",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
